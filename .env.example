NODE_ENV=development
PORT=3000
# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:5173
# Only used in production
COOKIE_DOMAIN=

# Postgres (compose.yaml exposes it on DB_PORT)
DB_HOST=localhost
DB_PORT=5433
DB_USERNAME=healthbridge
DB_PASSWORD=healthbridge
DB_DATABASE=healthbridge
# Auto-sync the schema from entities. Development only.
DB_SYNCHRONIZE=true

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=healthbridge

# JWT (TTLs in seconds). Use long random values for the secrets.
JWT_SECRET=change-me
JWT_REFRESH_SECRET=change-me-too
JWT_TTL=900
JWT_REFRESH_TTL=604800

# Mail (defaults point at Mailpit from compose.yaml; inbox at http://localhost:8025)
MAIL_FROM=no-reply@healthbridge.local
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USERNAME=
SMTP_PASSWORD=

# S3 storage
AWS_S3_BUCKET_NAME=
AWS_S3_BUCKET_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
